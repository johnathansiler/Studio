{
  "name": "cueharbor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "start": "concurrently -n web,signal -c green,cyan \"vite --host 0.0.0.0 --port 5173\" \"tsx server/index.ts\"",
    "dev": "npm start",
    "server": "tsx server/index.ts",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "serve": "SERVE_STATIC=1 tsx server/index.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ws": "^8.18.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^3.0.2"
  }
}
