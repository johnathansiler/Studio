{
  "name": "cueharbor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "start": "NODE_ENV=production node --experimental-strip-types server/index.ts",
    "dev": "concurrently -n web,signal -c green,cyan \"vite --host 0.0.0.0 --port 5173\" \"tsx server/index.ts\"",
    "server": "tsx server/index.ts",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "serve": "NODE_ENV=production node --experimental-strip-types server/index.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=22.6.0"
  },
  "dependencies": {
    "@breezystack/lamejs": "1.2.7",
    "onnxruntime-web": "^1.21.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ws": "^8.18.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "mpg123-decoder": "1.0.3",
    "playwright": "^1.56.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^3.0.2"
  }
}
